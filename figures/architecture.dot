digraph G { rankdir=LR; graph [bgcolor="white",fontname="Arial",pad=0.25, nodesep=0.35,ranksep=0.55]; node [shape=box,style="rounded,filled",fillcolor="#edf3fa",color="#355c7d",fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9,color="#52616b"];
subgraph cluster_eks { label="Amazon EKS workload and control plane"; color="#9aaec2"; audit [label="EKS Kubernetes\nAudit Logs"]; runtime [label="GuardDuty Runtime Agent\n(eBPF on supported nodes)"]; pods [label="Pods / Microservices\nEast-west + Egress"]; }
subgraph cluster_cloud { label="AWS detection and inspection"; color="#9aaec2"; gd [label="Amazon GuardDuty\nEKS Protection + Runtime",fillcolor="#dcefe4"]; flow [label="VPC Flow Logs /\nCloudWatch"]; nfw [label="AWS Network Firewall\nSuricata IPS rules",fillcolor="#fce8d5"]; waf [label="AWS WAF / Shield\nHTTP + DDoS",fillcolor="#fce8d5"]; hub [label="Security Hub / Detective"]; eb [label="EventBridge\nResponse routing"]; }
subgraph cluster_custom { label="Student implementation (reference prototype)"; color="#9aaec2"; engine [label="EKSIDS rules engine\nAudit + runtime + flow correlation",fillcolor="#fff2cc"]; plan [label="Approval-first response planner\nNetworkPolicy + Suricata export",fillcolor="#fff2cc"]; }
audit -> gd; runtime -> gd; pods -> runtime [style=dashed,label="runtime events"]; pods -> flow [style=dashed,label="flow metadata"]; pods -> nfw [label="routed traffic"]; waf -> pods [label="protected ingress"];
gd -> hub [label="findings"]; gd -> eb [label="finding events"]; flow -> engine [style=dashed]; audit -> engine [style=dashed,label="export / test adapter"]; runtime -> engine [style=dashed,label="event adapter"]; gd -> engine [style=dashed,label="finding adapter"]; engine -> plan [label="alerts + evidence"]; eb -> plan [label="customer automation pattern",style=dashed]; plan -> pods [label="operator-reviewed policy",style=dashed]; plan -> nfw [label="reviewed Suricata rule",style=dashed]; }
